# ==========================================
# IoT Water Level Monitoring System - Config
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Simulator Configuration
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=3000
DEMO_DEVICE_ID=ACCONEER-WL-001

# Tank & Calibration Parameters (Acconeer A121 reference)
TANK_HEIGHT_METERS=5.0
SENSOR_MOUNTING_HEIGHT_METERS=5.2
TANK_CRITICAL_HIGH_PERCENT=85.0
TANK_LOW_PERCENT=20.0

# MQTT Configuration
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPIC=growthtech/iot/water-level/device-001/telemetry
MQTT_CLIENT_ID=backend-water-level-service
MQTT_USERNAME=
MQTT_PASSWORD=

# Elasticsearch Configuration
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=iot-telemetry-water-level
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=

# GPS Service Configuration
GPS_SOURCE=SIMULATED_DEMO
GPS_ACCURACY_METERS=2.5
